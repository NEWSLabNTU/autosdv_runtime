#!/bin/bash
# AutoSDV Launch Script
# Generated during build with proper paths
# This script is called by the systemd service

set -e

# Configuration from CMake
WORKSPACE_DIR="@CMAKE_INSTALL_PREFIX@/../.."
ROS_DISTRO="@ROS_DISTRO@"

# Set up environment
export RCUTILS_COLORIZED_OUTPUT=1
export RCUTILS_LOGGING_USE_STDOUT=1

# Change to workspace directory
cd "$WORKSPACE_DIR"

# Source Autoware, then the workspace overlay.
#
# /opt/autoware/autoware-env was hardcoded here and does not exist on this
# install: the Debian packages put the environment at
# /opt/autoware/<version>/setup.bash. Under `set -e` that was a unit which
# failed at its first line with a missing-file error naming Autoware rather
# than naming the assumption. The newest versioned tree is used, so an upgrade
# does not need this script edited.
autoware_setup=$(ls -d /opt/autoware/*/setup.bash 2>/dev/null | sort -V | tail -1)
if [ -z "$autoware_setup" ] && [ -f /opt/autoware/autoware-env ]; then
    autoware_setup=/opt/autoware/autoware-env
fi
if [ -z "$autoware_setup" ]; then
    echo "autosdv-launch: no Autoware environment under /opt/autoware" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$autoware_setup"

# Source workspace
source "${WORKSPACE_DIR}/install/setup.bash"

# The CycloneDDS profile comes from the workspace, not from a path baked into
# the unit. autosdv.service used to pin CYCLONEDDS_URI to
# /opt/autoware/cyclonedds.xml, which ignores the tuning in this repo's own
# cyclonedds.xml -- and a DDS profile that silently differs between the unit
# and the terminal you debug it from is the hardest failure here to see from
# outside.
if [ -f "${WORKSPACE_DIR}/cyclonedds.xml" ]; then
    export CYCLONEDDS_URI="file://${WORKSPACE_DIR}/cyclonedds.xml"
fi

# Log startup
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting AutoSDV system..."
echo "Workspace: $WORKSPACE_DIR"
echo "ROS Distribution: $ROS_DISTRO"
echo "Autoware environment: $autoware_setup"
echo "CycloneDDS URI: ${CYCLONEDDS_URI:-unset}"
echo "System monitor available at: http://localhost:8080/"

# Launch the system
exec ros2 launch autosdv_launch autosdv.launch.yaml