<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_runtime</name>
  <version>0.1.0</version>
  <description>AutoSDV Runtime Management Tools for Production Environments</description>
  
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>
  
  <author email="jerry73204@gmail.com">aeon</author>
  
  <!-- Build dependencies -->
  <build_depend>ament_cmake</build_depend>
  <build_depend>ament_cmake_python</build_depend>
  
  <!-- Runtime dependencies -->
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>rclpy</exec_depend>
  
  <!-- AutoSDV dependencies -->
  <exec_depend>autosdv_launch</exec_depend>
  <exec_depend>autosdv_system_monitor</exec_depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>