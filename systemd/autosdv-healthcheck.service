[Unit]
Description=AutoSDV System Health Check
Documentation=https://github.com/NEWSLabNTU/AutoSDV
Requires=autosdv.service
After=autosdv.service

[Service]
Type=oneshot

# Environment
WorkingDirectory=%h

# Health check script - use ROS2 installed command
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && autosdv-healthcheck'

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autosdv-healthcheck