[Unit]
Description=AutoSDV System Health Check
Documentation=https://github.com/AutoSDV/AutoSDV
Requires=autosdv@%i.service
After=autosdv@%i.service

[Service]
Type=oneshot
User=%i
Group=%i

# Environment
Environment=HOME=/home/%i
WorkingDirectory=%h

# Health check script - use ROS2 installed command
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && autosdv-healthcheck'

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autosdv-healthcheck