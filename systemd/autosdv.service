[Unit]
Description=AutoSDV Autonomous Vehicle System
Documentation=https://github.com/NEWSLabNTU/AutoSDV
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=AUTOWARE_HOME=/opt/autoware
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# CYCLONEDDS_URI is deliberately not set here. The launch script exports the
# workspace's own cyclonedds.xml, and pinning a path in the unit would quietly
# override the tuning this repo ships.
WorkingDirectory=@AUTOSDV_WORKSPACE@

# Disable network isolation for ROS 2 DDS discovery
PrivateNetwork=no
IPAddressDeny=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateDevices=no

# Main execution - call the generated launch script
ExecStart=@AUTOSDV_WORKSPACE@/install/autosdv_runtime/share/autosdv_runtime/scripts/autosdv-launch.sh

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=300s
StartLimitBurst=5

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=120s
TimeoutStopSec=30s

# Logging
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=autosdv

[Install]
WantedBy=default.target