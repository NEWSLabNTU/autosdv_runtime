[Unit]
Description=AutoSDV Web Control Interface
Documentation=https://github.com/AutoSDV/AutoSDV
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=%i
Group=%i

# Environment setup
Environment=HOME=/home/%i
WorkingDirectory=%h

# Main execution command - use ROS2 installed command
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && autosdv-web-control --host=0.0.0.0 --port=8081'

# Restart policy
Restart=always
RestartSec=5s
StartLimitInterval=300s
StartLimitBurst=3

# Process management
KillMode=process
KillSignal=SIGTERM
TimeoutStartSec=30s
TimeoutStopSec=10s

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=%h/repos
ReadWritePaths=%h/.ros

# Resource limits
LimitNOFILE=1024

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autosdv-web-control

[Install]
WantedBy=default.target